<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the user allow this app to hand an APK to the system installer (Android 8+). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 16: lets the status notification be promoted to a Live Update. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <!-- Shares the downloaded APK with the installer, under an authority of its own. -->
        <provider
            android:name="app.pania.trailrecorder.UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- Runs while recording; the "location" type lets it keep receiving GPS fixes with the screen off. -->
        <service
            android:name="app.pania.trailrecorder.RecorderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Home screen widget (and lock screen where the device allows it) with the live stats. -->
        <receiver
            android:name="app.pania.trailrecorder.LiveWidgetProvider"
            android:exported="true"
            android:label="Pania">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pania_live_widget_info" />
        </receiver>
    </application>
</manifest>
